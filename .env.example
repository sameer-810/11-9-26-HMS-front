# Everything here ships inside the app bundle: public URLs only, never secrets.
# If the API host changes, update connect-src in vercel.json and the URLs in eas.json too.

# Production builds (Vercel web export, EAS preview/production) use these.
EXPO_PUBLIC_API_URL=https://one1-9-26-hms-back.onrender.com/api/v1
EXPO_PUBLIC_SOCKET_URL=https://one1-9-26-hms-back.onrender.com

# `expo start` uses these. Point them at Render to develop against the live API.
EXPO_PUBLIC_API_URL_DEV=http://localhost:5003/api/v1
EXPO_PUBLIC_SOCKET_URL_DEV=http://localhost:5003
